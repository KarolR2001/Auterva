# Local fixture only. Set a dedicated PostgreSQL URL and a random secret outside Git.
DATABASE_URL=
# Separate loopback database for the destructive, empty-database bootstrap test.
BOOTSTRAP_TEST_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3305
# Explicit approved base domains; production values are chosen at environment setup.
# Admin host: {slug}.AUTERVA_ADMIN_BASE_DOMAIN; public alias: {slug}.AUTERVA_PUBLIC_BASE_DOMAIN.
AUTERVA_ADMIN_BASE_DOMAIN=
AUTERVA_PUBLIC_BASE_DOMAIN=
WS_PORT=3312
# Worker mail (set a fresh random 32-byte hex key per environment; never commit it).
MAIL_PAYLOAD_KEY=
MAIL_ENVIRONMENT=development
MAIL_PROVIDER=sink
MAIL_ALLOWED_RECIPIENTS=qa@example.test
# Only when MAIL_PROVIDER=resend after provider/sender approval:
MAIL_FROM=
RESEND_API_KEY=

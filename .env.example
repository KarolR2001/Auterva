# Local fixture only. Set a dedicated PostgreSQL URL and a random secret outside Git.
DATABASE_URL=
# Separate loopback database for the destructive, empty-database bootstrap test.
BOOTSTRAP_TEST_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3305
# Explicit approved base domains; production values are chosen at environment setup.
# Admin host: {slug}.AUTERVA_ADMIN_BASE_DOMAIN; public alias: {slug}.AUTERVA_PUBLIC_BASE_DOMAIN.
AUTERVA_ADMIN_BASE_DOMAIN=
AUTERVA_PUBLIC_BASE_DOMAIN=
# CNAME target customers point their own domain at (#23, Cloudflare for SaaS target chosen in #3/#58). Empty = domains never become ready.
# Set the same value for the web process and the worker (#417): without it the worker skips the periodic check of
# active custom domains and the diagnostics "Sprawdź ponownie" answers 409 PLATFORM_CONFIG_REQUIRED.
AUTERVA_CUSTOM_DOMAIN_CNAME_TARGET=
WS_PORT=3312
# WebSocket listen address (default 127.0.0.1) and the exact Host values it accepts, comma separated (no wildcards).
# Loopback needs neither; any other address (a container: 0.0.0.0) requires WS_ALLOWED_HOSTS or the process refuses to start.
# The browser Origin must additionally be an active company-admin or platform host of the HostMapping registry.
WS_HOST=
WS_ALLOWED_HOSTS=
# Local only: the Host that start:local-ingress and dev:gateway send to the WS process when they forward /ws
# (default 127.0.0.1:<WS_PORT>; it must be one of WS_ALLOWED_HOSTS). dev:gateway also needs DEV_APP_PORT, the port of `pnpm dev`.
LOCAL_INGRESS_WS_HOST=
# Worker mail (set a fresh random 32-byte hex key per environment; never commit it).
MAIL_PAYLOAD_KEY=
MAIL_ENVIRONMENT=development
MAIL_PROVIDER=sink
MAIL_ALLOWED_RECIPIENTS=qa@example.test
# Only when MAIL_PROVIDER=resend after provider/sender approval:
MAIL_FROM=
RESEND_API_KEY=

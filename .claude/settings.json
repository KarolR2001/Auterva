{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree list *)",
      "Bash(git branch --show-current)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(scripts/agents/auterva-project.sh queue *)",
      "Bash(scripts/agents/auterva-project.sh ready *)",
      "Bash(scripts/agents/auterva-project.sh item *)",
      "Bash(scripts/agents/auterva-project.sh claims)",
      "Bash(scripts/agents/auterva-project.sh checkpoint-path)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm test:unit *)",
      "Bash(pnpm test:integration *)",
      "Bash(pnpm test:e2e *)",
      "Bash(pnpm build *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(gh pr merge * --admin *)",
      "Bash(gh pr review * --approve *)",
      "Bash(pnpm prisma migrate reset *)",
      "Bash(prisma migrate reset *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.codex/auth.json)",
      "Read(~/.codex/config.toml)",
      "Read(~/.config/gh/hosts.yml)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

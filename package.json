{
  "name": "auterva",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "start:local-ingress": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/start-local-ingress.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "tsx scripts/run-bootstrap-test.ts && vitest run tests/integration --maxWorkers=1",
    "test:e2e": "playwright test",
    "test": "pnpm test:unit && pnpm test:integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "dev:ws": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/server/realtime.ts",
    "dev:worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local src/server/worker.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.12",
    "@fontsource-variable/inter": "5.3.0",
    "@hookform/resolvers": "6.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@serwist/next": "9.5.13",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "postcss": "8.5.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@serwist/cli": "9.5.13",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "auth": "1.7.12",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "otpauth": "9.5.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "serwist": "9.5.13",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}

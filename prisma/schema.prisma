generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                     String             @id @default(uuid()) @db.Uuid
  slug                   String             @unique
  name                   String?
  firstAdminRegisteredAt DateTime?          @db.Timestamptz(6)
  archivedAt             DateTime?          @db.Timestamptz(6)
  publicUnlockRequired   Boolean            @default(false)
  publicRequiresPaid     Boolean            @default(false)
  version                Int                @default(0)
  domainVersion          Int                @default(0)
  vehicles               Vehicle[]
  messages               ChatMessage[]
  users                  User[]
  hosts                  HostMapping[]
  customDomain           CustomDomain?
  invitations            Invitation[]
  serviceAccess          ServiceAccess?
  settings               SiteSettings?
  publicMedia            PublicMedia[]
  redirects              SlugRedirect[]
  conversation           Conversation?
  auditLogs              AuditLog[]
  jobs                   Job[]
  operationReceipts      OperationReceipt[]
  reminderPlan           ReminderPlan?
  reminderIntents        ReminderIntent[]
  companyExports         CompanyExport[]
  calendarFeedTokens     CalendarFeedToken[]
}

model Vehicle {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @db.Uuid
  slug             String?
  name             String?
  brand            String?
  model            String?
  variant          String?
  year             Int?
  categoryId       String?             @db.Uuid
  shortDescription String?
  description      String?
  seats            Int?
  doors            Int?
  transmission     String?
  drive            String?
  fuel             String?
  color            String?
  luggage          String?
  price            Decimal?            @db.Decimal(12, 2)
  priceUnit        String?
  status           String              @default("DRAFT")
  featured         Boolean             @default(false)
  sortOrder        Int                 @default(0)
  availableFrom    DateTime?           @db.Date
  availableTo      DateTime?           @db.Date
  seoTitle         String?
  seoDescription   String?
  version          Int                 @default(0)
  updatedAt        DateTime            @default(now()) @updatedAt @db.Timestamptz(6)
  organization     Organization        @relation(fields: [organizationId], references: [id])
  category         VehicleCategory?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  blocks           AvailabilityBlock[]
  features         VehicleFeature[]
  images           VehicleImage[]
  imageUploads     ImageUpload[]
  redirects        SlugRedirect[]
  feedScopes       CalendarFeedTokenVehicle[]

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@index([organizationId, status, sortOrder])
  @@index([organizationId, updatedAt(sort: Desc), id])
}

model AvailabilityBlock {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  vehicleId      String   @db.Uuid
  from           DateTime @db.Date
  to             DateTime @db.Date
  type           String   @default("BLOCKED")
  source         String   @default("MANUAL")
  reference      String?
  internalNote   String?
  createdById    String?
  version        Int      @default(0)
  vehicle        Vehicle  @relation(fields: [organizationId, vehicleId], references: [organizationId, id])

  @@index([organizationId, vehicleId])
  @@index([vehicleId, from(sort: Desc)])
}

model ChatMessage {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @db.Uuid
  conversationId  String?                  @db.Uuid
  senderId        String?
  clientMessageId String                   @db.Uuid
  seq             Int?
  body            String
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  organization    Organization             @relation(fields: [organizationId], references: [id])
  conversation    Conversation?            @relation(fields: [organizationId, conversationId], references: [organizationId, id])
  sender          User?                    @relation(fields: [senderId], references: [id], onDelete: Restrict)
  readCursors     ConversationReadCursor[] @relation("CursorLastMessage")

  @@unique([organizationId, clientMessageId])
  @@unique([organizationId, conversationId, id])
  @@unique([conversationId, seq])
  @@index([organizationId, createdAt])
}

model User {
  id               String                   @id
  name             String
  email            String
  emailVerified    Boolean                  @default(false)
  image            String?
  createdAt        DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @db.Timestamptz(6)
  twoFactorEnabled Boolean?                 @default(false)
  organizationId   String?                  @db.Uuid
  role             String?
  disabledAt       DateTime?                @db.Timestamptz(6)
  /// #387: set when a recovery code removed the old factor and cleared when the new TOTP is confirmed (or by the
  /// operator procedure). While set, a password alone opens no session; only `mfaRecoverySessionId` may enroll.
  mfaRecoveryPendingAt DateTime?            @db.Timestamptz(6)
  mfaRecoverySessionId String?
  organization     Organization?            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions         Session[]
  accounts         Account[]
  twofactors       TwoFactor[]
  sentMessages     ChatMessage[]
  readCursors      ConversationReadCursor[]
  calendarFeedTokens CalendarFeedToken[]

  @@unique([email])
  @@index([organizationId])
  @@map("user")
}

model Session {
  id            String    @id
  expiresAt     DateTime  @db.Timestamptz(6)
  token         String
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)
  ipAddress     String?
  userAgent     String?
  mfaVerifiedAt DateTime? @db.Timestamptz(6)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  @@index([identifier])
  @@map("verification")
}

model PasswordResetRequest {
  id              String    @id @default(uuid()) @db.Uuid
  requestKeyHash  String    @unique @db.VarChar(64)
  inputHash       String    @db.VarChar(64)
  userId          String?
  verificationId  String?   @unique
  hostname        String    @db.VarChar(253)
  area            String    @db.VarChar(32)
  organizationId  String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime  @db.Timestamptz(6)
  consumedAt      DateTime? @db.Timestamptz(6)

  @@index([expiresAt])
  @@index([userId, createdAt])
}

model RateLimitEvent {
  id         String   @id @default(uuid()) @db.Uuid
  keyHash    String   @db.VarChar(64)
  occurredAt DateTime @db.Timestamptz(6)
  expiresAt  DateTime @db.Timestamptz(6)
  state      String   @default("COMMITTED")

  @@index([keyHash, occurredAt])
  @@index([expiresAt])
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime? @db.Timestamptz(6)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model HostMapping {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String?       @db.Uuid
  hostname        String        @unique
  area            String
  kind            String        @default("PROVIDER")
  status          String        @default("PENDING")
  canonicalTarget String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customDomain    CustomDomain?

  @@unique([id, organizationId])
  @@index([organizationId, area])
}

model CustomDomain {
  id                  String      @id @default(uuid()) @db.Uuid
  organizationId      String      @unique @db.Uuid
  hostMappingId       String      @unique @db.Uuid
  status              String      @default("PENDING_OWNERSHIP")
  verificationToken   String
  ownershipVerifiedAt DateTime?   @db.Timestamptz(6)
  routingVerifiedAt   DateTime?   @db.Timestamptz(6)
  tlsVerifiedAt       DateTime?   @db.Timestamptz(6)
  checkedAt           DateTime?   @db.Timestamptz(6)
  lastFailureCode     String?
  activatedAt         DateTime?   @db.Timestamptz(6)
  version             Int         @default(0)
  createdAt           DateTime    @default(now()) @db.Timestamptz(6)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  hostMapping         HostMapping  @relation(fields: [hostMappingId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([hostMappingId, organizationId])
}

model Invitation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  recipientEmail String
  issuedHost     String?
  tokenHash      String       @unique
  issueKey       String       @unique
  issuedAt       DateTime     @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime     @db.Timestamptz(6)
  usedAt         DateTime?    @db.Timestamptz(6)
  revokedAt      DateTime?    @db.Timestamptz(6)
  deliveryStatus String       @default("PENDING")
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, recipientEmail])
}

model ServiceAccess {
  organizationId String       @id @db.Uuid
  paidThrough    DateTime?    @db.Date
  trialGranted   Boolean      @default(false)
  trialStartedAt DateTime?    @db.Timestamptz(6)
  trialEndsAt    DateTime?    @db.Timestamptz(6)
  periodVersion  Int          @default(0)
  changedById    String?
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model VehicleCategory {
  id            String    @id @default(uuid()) @db.Uuid
  code          String    @unique
  name          String
  requiresSeats Boolean   @default(false)
  vehicles      Vehicle[]
}

model VehicleFeature {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String  @db.Uuid
  code           String
  value          String?
  vehicle        Vehicle @relation(fields: [organizationId, vehicleId], references: [organizationId, id])

  @@unique([organizationId, vehicleId, code])
}

model VehicleImage {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  vehicleId      String  @db.Uuid
  storageKey     String  @unique
  mime           String
  width          Int
  height         Int
  bytes          Int
  alt            String?
  position       Int     @default(0)
  isCover        Boolean @default(false)
  status         String  @default("PENDING")
  variants       Json?
  version        Int     @default(0)
  storageCleanedAt DateTime? @db.Timestamptz(6)
  vehicle        Vehicle @relation(fields: [organizationId, vehicleId], references: [organizationId, id])

  @@index([organizationId, vehicleId, position])
  @@index([status, storageCleanedAt])
}

model ImageUpload {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  vehicleId      String?  @db.Uuid
  publicKind     String?
  reservationKey String   @db.Uuid
  imageId        String   @unique @db.Uuid
  stagingKey     String   @unique
  rawKey         String   @unique
  state          String   @default("RESERVED")
  expiresAt      DateTime @db.Timestamptz(6)
  leaseUntil     DateTime? @db.Timestamptz(6)
  storageCleanedAt DateTime? @db.Timestamptz(6)
  rawSha256      String?  @db.VarChar(64)
  rawBytes       Int?
  mime           String?
  width          Int?
  height         Int?
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @db.Timestamptz(6)
  vehicle        Vehicle? @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, vehicleId, reservationKey])
  @@index([organizationId, vehicleId, state])
  @@index([state, expiresAt])
}

model SiteSettings {
  organizationId       String       @id @db.Uuid
  publicName           String?
  shortDescription     String?
  phone                String?
  whatsapp             String?
  email                String?
  contactChannel       String?
  addressLine          String?
  postalCode           String?
  city                 String?
  country              String?
  mapLatitude          Decimal?     @db.Decimal(9, 6)
  mapLongitude         Decimal?     @db.Decimal(9, 6)
  contactHours         String?
  showPrices           Boolean      @default(false)
  featuredVehicleCount Int          @default(0)
  seoTitle             String?
  seoDescription       String?
  privacyText          String?
  termsText            String?
  privacyTextUpdatedAt DateTime?    @db.Timestamptz(6)
  termsTextUpdatedAt   DateTime?    @db.Timestamptz(6)
  availabilityNotice   String?
  heroText             String?
  serviceArea          String?
  privacyUrl           String?
  termsUrl             String?
  operatorNote         String?
  version              Int          @default(0)
  updatedAt            DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  organization         Organization @relation(fields: [organizationId], references: [id])
}

model PublicMedia {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  kind           String
  storageKey     String       @unique
  alt            String?
  position       Int          @default(0)
  status         String       @default("PENDING")
  mime           String?
  width          Int?
  height         Int?
  bytes          Int?
  variants       Json?
  version        Int          @default(0)
  storageCleanedAt DateTime?  @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, kind, position])
  @@index([status, storageCleanedAt])
}

model SlugRedirect {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  vehicleId      String       @db.Uuid
  oldSlug        String
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id])
  vehicle        Vehicle      @relation(fields: [organizationId, vehicleId], references: [organizationId, id])

  @@unique([organizationId, oldSlug])
}

model Conversation {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @unique @db.Uuid
  createdAt      DateTime                 @default(now()) @db.Timestamptz(6)
  lastSeq        Int                      @default(0)
  activityAt     DateTime                 @default(now()) @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id])
  messages       ChatMessage[]
  readCursors    ConversationReadCursor[]

  @@unique([organizationId, id])
}

model ConversationReadCursor {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  conversationId String       @db.Uuid
  userId         String
  lastMessageId  String?      @db.Uuid
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [organizationId, conversationId], references: [organizationId, id])
  user           User         @relation(fields: [userId], references: [id])
  lastMessage    ChatMessage? @relation("CursorLastMessage", fields: [organizationId, conversationId, lastMessageId], references: [organizationId, conversationId, id], onDelete: Restrict)

  @@unique([conversationId, userId])
  @@index([organizationId, conversationId])
}

model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  eventKey       String?       @unique @db.Uuid
  organizationId String?       @db.Uuid
  actorId        String
  actorRole      String
  action         String
  entityType     String
  entityId       String
  safeChanges    Json?
  requestId      String
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, createdAt, id])
  @@index([createdAt, id])
  @@index([requestId])
}

model Job {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  kind           String
  dedupeKey      String
  payload        Json
  runAt          DateTime      @db.Timestamptz(6)
  attempts       Int           @default(0)
  maxAttempts    Int           @default(5)
  status         String        @default("PENDING")
  lockedUntil    DateTime?     @db.Timestamptz(6)
  leaseToken     String?       @db.Uuid
  firstSendAt    DateTime?     @db.Timestamptz(6)
  providerId     String?
  completedAt    DateTime?     @db.Timestamptz(6)
  errorCode      String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  retentionManifests AuditRetentionManifest[]
  reminderIntents    ReminderIntent[]

  @@unique([organizationId, dedupeKey])
  @@index([kind, status, runAt])
  @@index([status, runAt])
  @@index([status, lockedUntil])
}

model AuditRetentionManifest {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  batch     Int
  count     Int
  oldestAt  DateTime @db.Timestamptz(6)
  newestAt  DateTime @db.Timestamptz(6)
  digest    String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@unique([jobId, batch])
}

model AuditOperatorExport {
  id           String    @id @default(uuid()) @db.Uuid
  fromAt       DateTime  @db.Timestamptz(6)
  toAt         DateTime  @db.Timestamptz(6)
  count        Int
  digest       String?
  artifactName String    @unique
  expiresAt    DateTime  @db.Timestamptz(6)
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  completedAt  DateTime? @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  errorCode    String?

  @@index([status, expiresAt])
}

model OperationReceipt {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  actorId        String
  area           String
  operation      String
  idempotencyKey String
  inputHash      String
  result         Json
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  expiresAt      DateTime?     @db.Timestamptz(6)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, actorId, area, operation, idempotencyKey])
  @@index([organizationId, expiresAt])
}

model PlatformLegalDocument {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  body      String
  version   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

// #54: effective period boundary the reminder schedule was last reconciled for.
model ReminderPlan {
  organizationId  String       @id @db.Uuid
  effectiveEndsAt DateTime?    @db.Timestamptz(6)
  source          String?
  periodVersion   Int          @default(0)
  updatedAt       DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
}

// #54: durable reminder intent; the unique key is the delivery key per channel.
model ReminderIntent {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  effectiveEndsAt DateTime     @db.Timestamptz(6)
  offsetDays      Int
  channel         String
  slotAt          DateTime     @db.Timestamptz(6)
  source          String
  periodVersion   Int
  status          String       @default("PENDING")
  jobId           String?      @db.Uuid
  deliveredAt     DateTime?    @db.Timestamptz(6)
  errorCode       String?
  attempts        Int          @default(0)
  nextAttemptAt   DateTime?    @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  job             Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([organizationId, effectiveEndsAt, offsetDays, channel])
  @@index([status, slotAt])
  @@index([organizationId, status])
}

/// #328 (D-40): one export of a company's own data. The encrypted ZIP lives in private storage under `artifactKey`
/// (company-prefixed); the row carries state, expiry and digest. At most one PENDING row per company (partial unique index).
model CompanyExport {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @db.Uuid
  requestedById    String
  requestedByRole  String
  idempotencyKey   String        @db.Uuid
  /// "ARCHIVED_COMPANY" when the superadmin requested it inside the 30-day archive window (E8).
  context          String?
  status           String        @default("PENDING")
  artifactKey      String        @unique
  digest           String?
  bytes            Int?
  counts           Json?
  expiresAt        DateTime?     @db.Timestamptz(6)
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  completedAt      DateTime?     @db.Timestamptz(6)
  deletedAt        DateTime?     @db.Timestamptz(6)
  storageCleanedAt DateTime?     @db.Timestamptz(6)
  errorCode        String?
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, requestedById, idempotencyKey])
  @@index([organizationId, createdAt])
  @@index([status, expiresAt])
}

// #327 (D-40): private iCal feed token. Only the SHA-256 of the secret is stored; the secret is shown once.
// Rows are never restored from a backup (the creating user rows are replaced, which cascades here).
model CalendarFeedToken {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  createdByUserId String
  label           String
  tokenHash       String       @unique
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  expiresAt       DateTime     @db.Timestamptz(6)
  lastUsedAt      DateTime?    @db.Timestamptz(6)
  revokedAt       DateTime?    @db.Timestamptz(6)
  revokedReason   String?
  // #366 (E11): "FLEET" (every published vehicle) or "VEHICLES" (only the rows of CalendarFeedTokenVehicle). Stored
  // explicitly, so a token whose selected vehicles all disappear stays narrow (empty calendar) instead of widening.
  scope           String       @default("FLEET")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy       User         @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  vehicles        CalendarFeedTokenVehicle[]

  @@unique([organizationId, id])
  @@index([organizationId, revokedAt, expiresAt])
  @@index([createdByUserId])
}

// #366 (E11): vehicles selected for a token with scope VEHICLES. Composite keys keep the token and the vehicle in one
// company; deleting either side removes the row. Never restored from a backup (the tokens are not).
model CalendarFeedTokenVehicle {
  organizationId String            @db.Uuid
  tokenId        String            @db.Uuid
  vehicleId      String            @db.Uuid
  token          CalendarFeedToken @relation(fields: [organizationId, tokenId], references: [organizationId, id], onDelete: Cascade)
  vehicle        Vehicle           @relation(fields: [organizationId, vehicleId], references: [organizationId, id], onDelete: Cascade)

  @@id([tokenId, vehicleId])
  @@index([organizationId, vehicleId])
}
